 "values": [
  {
   "name": "the sorting example of RFC 8785, section 3.2.3",
   "text": "{\"\u20ac\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"1\":\"One\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\"}",
   "prints": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}",
   "note": "Names sort by their UTF-16 code units, so the emoji sorts before U+FB33."
  },
  {
   "name": "white space and member order",
   "text": "{ \"b\" : [ 1 , 2 ] , \"a\" : { \"y\" : null , \"x\" : true } }",
   "prints": "{\"a\":{\"x\":true,\"y\":null},\"b\":[1,2]}"
  },
  {
   "name": "string escapes",
   "text": "\"\\u000f\\n\\\"\\\\\\/\u00e9\u2028\"",
   "prints": "\"\\u000f\\n\\\"\\\\/\u00e9\u2028\"",
   "note": "Only what JSON must escape is escaped. The solidus, U+2028 and letters outside ASCII are written as they are."
  },
  {
   "name": "the short escapes",
   "text": "\"\\b\\t\\f\\r\\u0008\"",
   "prints": "\"\\b\\t\\f\\r\\b\"",
   "note": "RFC 8785 writes backspace, tab, form feed, line feed and carriage return in their two-character form, however the text gave them."
  },
  {
   "name": "one number written three ways",
   "text": "[1.0, 1e0, 100e-2]",
   "prints": "[1,1,1]"
  },
  {
   "name": "where the exponent starts",
   "text": "[1e21, 1e-7, 0.000001, 123456789012345680000]",
   "prints": "[1e+21,1e-7,0.000001,123456789012345680000]"
  },
  {
   "name": "an integer past 2^53",
   "text": "9007199254740993",
   "prints": "9007199254740992",
   "note": "As vcrs-php prints it: the nearest double. A statement refuses a whole number past 2^53, so it never meets this."
  },
  {
   "name": "minus zero",
   "text": "-0.0",
   "prints": "0",
   "note": "Appendix B prints 0. Erratum 7920 adds that a parser should raise an error on -0. vcrs-php prints 0."
  }
 ],
